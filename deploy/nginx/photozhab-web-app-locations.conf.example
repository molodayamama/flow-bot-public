# Include inside the existing TLS server block for https://photozhab.ru.
# The static /app.html, /app.css and /app.js stay in /var/www/photozhab; only
# the bounded first-party API is proxied to the consumer process.

location /web/api/ {
    client_max_body_size 12m;
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 480s;
    proxy_send_timeout 30s;
}
