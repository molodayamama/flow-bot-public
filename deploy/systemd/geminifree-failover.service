[Unit]
Description=GeminiFree FI/NL failover controller
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/geminifree
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/geminifree/failover.env
ExecStart=/opt/geminifree/.venv/bin/python /opt/geminifree/tools/failover_controller.py tick
Nice=5
