[Unit]
Description=GeminiFree Flow Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/geminifree
Environment=PYTHONUNBUFFERED=1
Environment=ENV_FILE=/opt/geminifree/.env
ExecStart=/usr/local/bin/geminifree-bot-run
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
