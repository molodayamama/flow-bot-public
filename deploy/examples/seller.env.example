# Seller bot env template. Copy to /opt/geminifree/.env.seller on the VPS.
# Placeholders only. Never commit real tokens, keys, cookies, proxies, or profiles.

TELEGRAM_TOKEN=123456789:AAExampleSellerTokenReplaceMe
BOT_USERNAME=photozhab_wb_bot
BOT_MODE=seller
USER_CREDITS_FILE=user_credits_seller.json

# Share Flow account pool and metrics DB with the consumer service.
USER_DATA_DIR=./google_profile
FLOW_ACCOUNT_ID=default
FLOW_ACCOUNTS=
FLOW_ACCOUNTS_STATE_FILE=flow_accounts_state.json
METRICS_DB=metrics.db

# Use a separate local port so the seller process can receive seller Robokassa
# callbacks without colliding with the consumer admin/API process on 8081.
# Wire the public reverse proxy explicitly before enabling SBP/Card top-ups here.
ROBOKASSA_WEB_HOST=127.0.0.1
ROBOKASSA_WEB_PORT=8082

# Optional: keep SBP/Card hidden in the seller bot until the reverse proxy and
# Robokassa callback URL are wired to this service. Telegram Stars still works.
SBP_PAYMENT_ENABLED=0
