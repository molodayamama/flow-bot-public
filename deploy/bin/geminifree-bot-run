#!/usr/bin/env bash
set -euo pipefail
cd /opt/geminifree
export ENV_FILE="${ENV_FILE:-/opt/geminifree/.env}"
PYTHON=/opt/geminifree/.venv/bin/python
"$PYTHON" /opt/geminifree/tools/production_preflight.py \
  --root /opt/geminifree --env-file "$ENV_FILE"
exec /usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" "$PYTHON" /opt/geminifree/flow_bot.py
