# .env.example — полный шаблон конфигурации flow_bot.py.
# Скопировать в .env и заполнить только нужные строки.
# Минимальный/рекомендуемый набор см. docs/ENV_SETUP.md.
# ТОЛЬКО ПЛЕЙСХОЛДЕРЫ. Реальные значения никогда не коммитить.

# ── Обязательные ──────────────────────────────────────────────────────────────

# Токен Telegram-бота от @BotFather
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID владельца(ев) бота через запятую/точку с запятой (owner = админ).
# Только они видят /admin_help (справочник всех команд).
OWNER_ID=111111111

# Telegram ID админов через запятую (могут /grant <user_id> <credits> и видят тест-пакет)
ADMIN_IDS=111111111,222222222

# ── Браузер / Flow-сессия ────────────────────────────────────────────────────

# Путь к персистентному Chrome-профилю с залогиненным Google-аккаунтом
USER_DATA_DIR=./google_profile

# Ярлык Flow-аккаунта для метрик (flow_jobs в metrics.db)
FLOW_ACCOUNT_ID=default

# Выдавать каждому юзеру отдельный Flow-проект (0/false — общий проект сессии)
PER_USER_PROJECTS=1

# Пул Flow-аккаунтов: записи "id=путь_к_chrome_профилю" через ';' (или ',').
# Разделитель id/путь — именно '=' (в Windows-путях есть ':'). Пусто = один
# аккаунт FLOW_ACCOUNT_ID на USER_DATA_DIR. Второй аккаунт = вторая запись,
# код менять не нужно. Привязки юзеров хранятся в flow_accounts_state.json.
# Per-account proxy: append |proxy=URL to use one proxy for Chrome and Flow API,
# or |browser_proxy=URL|api_proxy=URL to split them. Values off/none/direct disable proxy.
# FLOW_ACCOUNTS=main=./google_profile;acc2=./google_profile_acc2|proxy=http://127.0.0.1:8118

# Файл привязок user→account пула (runtime state, в .gitignore)
# FLOW_ACCOUNTS_STATE_FILE=flow_accounts_state.json

# ── Прокси (все опциональны; пусто = без прокси) ─────────────────────────────

# Общий прокси по умолчанию (http/socks5) — фолбэк для браузера и API
PROXY_URL=

# Прокси только для браузера Playwright (переопределяет PROXY_URL)
BROWSER_PROXY_URL=

# Прокси только для HTTP-вызовов Flow API (переопределяет PROXY_URL)
API_PROXY_URL=

# Прокси, который CapMonster использует при решении капчи
CAPMONSTER_PROXY_URL=

# SOCKS5-прокси для Telegram Bot API (aiohttp-socks ProxyConnector)
TG_PROXY_URL=

# ── Капча (опционально; основной путь — бесплатный браузерный grecaptcha) ───

# Провайдер: auto (browser → capmonster → 2captcha) | browser | capmonster | 2captcha
CAPTCHA_PROVIDER=auto

# API-ключ 2Captcha (платный фолбэк; пусто = не используется)
TWOCAPTCHA_KEY=

# Минимальный score для 2Captcha reCAPTCHA v3
TWOCAPTCHA_SCORE=0.3

# Таймаут решения 2Captcha, секунд
TWOCAPTCHA_SOLVE_TIMEOUT=150

# API-ключ CapMonster (платный фолбэк; пусто = не используется)
CAPMONSTER_KEY=

# Таймаут решения CapMonster, секунд
CAPMONSTER_SOLVE_TIMEOUT=120

# ── Gemini API (опционально) ─────────────────────────────────────────────────

# API-ключ Gemini для «Улучшить промпт» в визарде. Пусто = кнопка скрыта.
# Бесплатный ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Public browser-client key used by the Google credits endpoint. Keep the
# runtime value only in .env; never commit it.
FLOW_BROWSER_API_KEY=

# ── Монетизация / рефералка ──────────────────────────────────────────────────

# Курс Stars→рубли для оценки выручки в метриках (~₽ за 1 Star, best-effort)
STARS_TO_RUB=1.3

# Username бота для реферальных и рекламных deep-link'ов (фолбэк; обычно берётся
# из get_me() на старте). Нужен для ссылок вида t.me/<bot>?start=seed_<канал>.
BOT_USERNAME=

# Режим бота: consumer (по умолчанию) или seller (@photozhab_wb_bot — меню
# «Маркетплейсы», селлерские пакеты). Один код, флаг на процесс. Для второго
# (селлерского) бота запусти отдельный процесс со своим окружением:
#   TELEGRAM_TOKEN=<токен @photozhab_wb_bot>
#   BOT_USERNAME=photozhab_wb_bot
#   BOT_MODE=seller
#   USER_CREDITS_FILE=user_credits_seller.json   # раздельный кошелёк
# metrics.db общая (включить WAL). См. docs/SELLER_BOT_PLAN.md.
BOT_MODE=consumer

# Общий секрет для внутреннего генератор-бэкенда (SELLER_BOT_PLAN.md §A).
# Если задан в consumer — он поднимает localhost-эндпоинт /internal/generate;
# seller-процесс должен иметь ТОТ ЖЕ токен + BACKEND_HOST/BACKEND_PORT
# (порт consumer-вебсервера, по умолчанию 8081), чтобы ходить в пул основного
# бота и не поднимать свой. Пусто = бэкенд выключен.
INTERNAL_API_TOKEN=
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8081
# BACKEND_TIMEOUT_SEC=420
# WEB_CLIENT_MAX_SIZE=33554432

# ── Пути к runtime-стейту (дефолты обычно менять не нужно; всё в .gitignore) ─

# Карта telegram_user_id -> flow_project_id
USER_PROJECTS_FILE=user_projects.json

# Балансы кредитов юзеров + отметка стартового бонуса
USER_CREDITS_FILE=user_credits.json

# Журнал Stars-платежей (charge id для рефандов)
PAYMENTS_FILE=payments.json

# Production invariant: balances and payment settlement use one atomic SQLite DB.
# Existing JSON balances are imported idempotently on the first SQLite startup.
CREDITS_SQLITE=1

# Robokassa Card/SBP. Secrets stay only in real .env files.
# ROBOKASSA_ENABLED=1
# ROBOKASSA_MERCHANT_LOGIN=photozhab
# ROBOKASSA_HASH_ALGO=sha256
# ROBOKASSA_PASSWORD1=replace_me
# ROBOKASSA_PASSWORD2=replace_me
# ROBOKASSA_INC_CURR_LABEL=SBP
# ROBOKASSA_WEB_HOST=127.0.0.1
# ROBOKASSA_WEB_PORT=8081
# ROBOKASSA_PUBLIC_BASE_URL=https://pay.example.com
# Callback routing between consumer/seller processes. New invoices carry signed
# Shp_bot=consumer|seller, so a callback that lands on the wrong process can be
# forwarded to the right local wallet before credits are issued.
ROBOKASSA_SCOPE=consumer
ROBOKASSA_CONSUMER_RESULT_URL=http://127.0.0.1:8081/robokassa/result
ROBOKASSA_SELLER_RESULT_URL=http://127.0.0.1:8082/robokassa/result
ROBOKASSA_CONSUMER_BOT_USERNAME=photozhab_bot
ROBOKASSA_SELLER_BOT_USERNAME=photozhab_wb_bot

# Telemetr.me channel lookup for admin CAC calculator (Bearer token in the
# Authorization header). Keep the real token only in production .env files;
# never commit it. TGSTAT_API_TOKEN is still read as a fallback during migration.
# TELEMETR_API_TOKEN=replace_me
TELEMETR_CACHE_TTL_SEC=21600

# Изученный формат запроса редактирования (imageInputs), перехваченный из браузера
EDIT_CAPTURE_FILE=edit_capture.json

# Сырой дамп перехваченной правки (для ручной доводки шаблона)
EDIT_CAPTURE_RAW_FILE=edit_capture_raw.json

# Недавно выданные картинки (id) — переживают рестарт
RECENT_IMAGES_FILE=recent_images.json

# Схемы ответов на загрузку фото (values-free) — для доводки, если mediaId не нашёлся
UPLOAD_CAPTURE_FILE=upload_capture.json

# Изученный формат запроса настоящего апскейла (перехватывается один раз)
UPSCALE_CAPTURE_FILE=upscale_capture.json

# SQLite-база метрик (латентность, джобы, выручка)
METRICS_DB=metrics.db

# Каталог версионированных промпт-файлов (prompts_lib.py; пусто = ./prompts)
# PROMPTS_DIR=./prompts

# ── MAX bot (optional second channel; disabled unless MAX_ENABLED=1) ──
# MAX_ENABLED=0
# MAX_BOT_TOKEN=            # bot token; sent as the Authorization header
# MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX_MODE=poll            # poll (default) or webhook (production intake)
# MAX_WEBHOOK_URL=https://bot.example.com/max/webhook  # required in production webhook mode
# MAX_WEBHOOK_SECRET=       # required for webhook mode (X-Max-Bot-Api-Secret)
# MAX_INBOX_DB=max_webhook_inbox.db  # durable webhook dedup/retry inbox
# MAX_INBOX_WORKERS=4       # concurrent users; order is preserved per user
# MAX uses the Russian Trusted Root CA (not in the certifi/Mozilla bundle).
# Point MAX_CA_BUNDLE at that root PEM (or install it system-wide) or TLS fails.
# MAX_CA_BUNDLE=/etc/ssl/certs/russian_trusted_root_ca.pem
# MAX_SMOKE_USER_ID=        # tools/max_smoke.py only; never commit a real id
# MAX_SMOKE_CHAT_ID=        # tools/max_smoke.py only; never commit a real id
